# KalaSetu Environment Configuration
# ==============================================================================
# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# AI & Processing Provider Keys (Optional for local/unconfigured mode)
# If left empty, the application UI clearly displays that the service is unavailable
# rather than faking responses.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_HUGGINGFACE_API_KEY=
